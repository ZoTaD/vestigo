{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client"],
    "paths": {
      "@deadlock/*": ["../games/deadlock/data/*"],
      "@poe2/*": ["../games/poe2/data/*"],
      "@valheim/*": ["../games/valheim/data/site/*"],
      "@valheimMap/*": ["../games/valheim/data/map/*"],
      "@d2r/*": ["../games/d2r/data/*"],
      "@zomboid/*": ["../games/zomboid/data/*"],
      "@rust/*": ["../games/rust/data/*"],
      "@terraria/*": ["../games/terraria/data/*"],
      "@stardew/*": ["../games/stardew/data/*"],
      "@warframe/*": ["../games/warframe/data/*"],
      "@cs2/*": ["../games/cs2/data/*"],
      "@coh3/*": ["../games/coh3/data/*"],
      "@coh3stats/*": ["../games/coh3/stats/*"],
      "@coh2stats/*": ["../games/coh2/stats/*"],
      "@coh2/*": ["../games/coh2/data/*"],
      "@coh1stats/*": ["../games/coh1/stats/*"],
      "@coh1/*": ["../games/coh1/data/*"],
      "@cs2prices/*": ["../games/cs2/prices/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
