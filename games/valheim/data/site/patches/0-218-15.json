ext":"Furniture: Ashwood Bed","dir":"new","refs":["building/ashwood-bed"]},{"text":"Furniture: Bone Throne","dir":"new","refs":["building/bone-throne"]},{"text":"Furniture: Lava Lantern","dir":"new","refs":["building/lava-lantern"]},{"text":"Furniture: Asksvin Rug","dir":"new","refs":["building/asksvin-rug"]},{"text":"Furniture: Straw","dir":"new","refs":["building/straw"]},{"text":"Furniture: Small Green Pot","dir":"new","refs":["building/small-green-pot"]},{"text":"Furniture: Medium Green Pot","dir":"new","refs":["building/medium-green-pot"]},{"text":"Furniture: Large Green Pot","dir":"new","refs":["building/large-green-pot"]},{"text":"Furniture: Ashwood Bench","dir":"new","refs":["building/ashwood-bench"]},{"text":"Furniture: Asksvin Skeleton","dir":"new","refs":["building/asksvin-skeleton"]},{"text":"Siege Machine: Catapult","dir":"new","refs":["building/catapult"]},{"text":"Siege Machine: Battering Ram","dir":"new","refs":["building/battering-ram"]},{"text":"Ship: Drakkar","dir":"new","refs":["building/drakkar"]},{"text":"Misc: Shield Generator","dir":"new","refs":["building/shield-generator"]},{"text":"Misc: Portal – Stone","dir":"new","refs":["building/portal-stone"]}]},{"title":"Food & Potions","lines":[{"text":"Food: Cooked Volture Meat","dir":"new","refs":["foods/cooked-volture-meat"]},{"text":"Food: Cooked Bonemaw Meat","dir":"new","refs":["foods/cooked-bonemaw-meat"]},{"text":"Food: Cooked Asksvin Tail","dir":"new","refs":["foods/cooked-asksvin-tail"]},{"text":"Food: Fiddlehead","dir":"new","refs":["foods/fiddlehead"]},{"text":"Food: Fiery Svinstew","dir":"new","refs":["foods/fiery-svinstew"]},{"text":"Food: Marinated Greens","dir":"new","refs":["foods/marinated-greens"]},{"text":"Food: Mashed Meat","dir":"new","refs":["foods/mashed-meat"]},{"text":"Food: Piquant Pie (cooked/uncooked)","dir":"new","refs":["foods/piquant-pie"]},{"text":"Food: Roasted Crust Pie (cooked/uncooked)","dir":"new","refs":["foods/roasted-crust-pie"]},{"text":"Food: Scorching Medley","dir":"new","refs":["foods/scorching-medley"]},{"text":"Food: Sizzling Berry Broth","dir":"new","refs":["foods/sizzling-berry-broth"]},{"text":"Food: Smoke Puff","dir":"new","refs":["foods/smoke-puff"]},{"text":"Food: Sparkling Shroomshake","dir":"new","refs":["foods/sparkling-shroomshake"]},{"text":"Food: Spicy Marmalade","dir":"new","refs":["foods/spicy-marmalade"]},{"text":"Food: Vineberry Cluster","dir":"new","refs":["foods/vineberry-cluster"]},{"text":"Mead: Lingering Healing Mead","dir":"new","refs":["meads/lingering-healing-mead"]},{"text":"Mead: Lingering Eitr Mead","dir":"new","refs":["meads/lingering-eitr-mead"]}]},{"title":"Misc","lines":[{"text":"Location: Ruins (multiple)","dir":"new"},{"text":"Location: Redbeard Dvergr Outposts","dir":"new"},{"text":"Location: Putrid Hole","dir":"new"},{"text":"Location: Charred Fortress","dir":"new"},{"text":"Event: “The undead army marches”","dir":"new"},{"text":"Event: “The dead have been summoned”","dir":"new"},{"text":"Lore: New stones","dir":"mid"},{"text":"Lore: New dreams","dir":"mid"},{"text":"Lore: New Munin dialogue","dir":"mid"},{"text":"New music","dir":"new"},{"text":"New forsaken power","dir":"new"},{"text":"Terrain changes for Ashlands (Ashlands is now cut off from other biomes, only accessible by sea)","dir":"mid","refs":["biomes/ashlands"]}]},{"title":"Fixes & Improvements","lines":[{"text":"Fixed Major Healing Mead material","dir":"fix","refs":["meads/major-healing-mead"]},{"text":"Fixed Minor Eitr Mead Material","dir":"fix","refs":["meads/minor-eitr-mead"]},{"text":"Standardised texts throughout the game","dir":"mid"},{"text":"Updated names for old Flametal items","dir":"mid","refs":["materials/flametal"]},{"text":"The popup for unlocking new things is displayed longer","dir":"mid"},{"text":"Disabled ESRAM usage on Xbox One to work around a Unity bug that caused some particle systems to have corrupt shadowmaps","dir":"mid"},{"text":"Added console command ‘findtp’ to go to nearest found item","dir":"new"},{"text":"Added console command ‘setfuel’ to fill all nearby lights to specified fuel","dir":"new"},{"text":"Map is now closed after using debugmode teleport","dir":"mid"},{"text":"There is now a toggle in Gamplay Settings for “Attack towards look direction”, if this is toggled off, attacks will instead be made in the direction the camera is facing","dir":"mid"},{"text":"Modding: IMonoUpdater no longer requires to be inherited from and error messages removed","dir":"mid"},{"text":"Once more, please do remember to check out the preparation guide before you set sail towards the Ashlands, it contains important information!","note":true,"refs":["biomes/ashlands"]},{"text":"NOTE! Unfortunately there are currently some issues with the Microsoft and Xbox versions of Valheim, which means there will be a slight delay in getting the update properly uploaded there. However, the current version on Xbox Flight is the same as the version coming to live, so crossplay will still be possible between Xbox Flight and Default Steam games.","note":true}]}]}