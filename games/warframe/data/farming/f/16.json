ncubationitems-kavatgeneticstrain","planets":[["Deimos","Deimos"]],"sources":[{"k":"other","where":"Hallowed Flame Mission Caches (Rotation C)","chance":5.53},{"k":"other","where":"Hallowed Flame Endurance Caches (Rotation C)","chance":11.06}],"usedIn":["Powersuits/Khora/Khora"],"refs":{"Powersuits/Khora/Khora":{"tab":"arsenal","slug":"khora","slugEs":"khora","name":["Khora","Khora"],"img":"storeicons-warframes-khora"}}},"mawfish-bones":{"slug":"mawfish-bones","slugEs":"huesos-de-pez-bocon","name":["Mawfish Bones","Huesos de Pez Bocón"],"desc":["The bones of the Mawfish are carved by the Ostron to produce ornaments and tools.\n\nSource: Cut from Mawfish via Fisher Hai-Luk in Cetus (Earth). Catch Mawfish in the Plains of Eidolon lake during the Day. Also drops from Thumpers in the Plains of Eidolon.","Los huesos del pez bocón son tallados por los ostronitas para producir adornos y herramientas.\n\nFuente: Extraído del pez bocón con la Pescadora Hai-Luk en Cetus (Tierra). Captura peces bocones en el lago de las Llanuras de Eidolon durante el día. También se obtiene de los pistones en las Llanuras de Eidolon."],"img":"storeicons-fishing-eidolon-fishresourcebones","planets":[],"sources":[{"k":"enemy","who":"Tusk Thumper Doma","eff":33.36},{"k":"enemy","who":"Tusk Thumper Bull","eff":25.02},{"k":"enemy","who":"Tusk Thumper","eff":16.68},{"k":"enemy","who":"Narmer Thumper Doma","eff":33.36},{"k":"enemy","who":"Narmer Thumper Bull","eff":25.02},{"k":"enemy","who":"Narmer Thumper","eff":16.68}],"usedIn":["Weapons/Grineer/Melee/GrnSparring/GrnSpiderSparring/GrnSpiderSparring"],"refs":{"Weapons/Grineer/Melee/GrnSparring/GrnSpiderSparring/GrnSpiderSparring":{"tab":"arsenal","slug":"korrudo","slugEs":"korrudo","name":["Korrudo","Korrudo"],"img":"storeicons-weapons-meleeweapons-weapons-grnspidersparring"}}},"vega-toroid":{"slug":"vega-toroid","slugEs":"toroide-vega","name":["Vega Toroid","Toroide Vega"],"desc":["A device of undetermined function and origin. Prized by Vox Solaris and the Quills.\n\nEarn Vega Toroids from enemies located at the Spaceport in the Orb Vallis and from Mite Raknoids. They can also be found as pick-ups in caves located around the Orb Vallis (Venus).","Un dispositivo de función y origen indeterminado. Valorado por Vox Solaris y los Raquis.\n\nGana toroides Vega de enemigos ubicados en el puerto espacial en los Valles del Orbe y de raknoides Enanos. También se pueden encontrar en cuevas ubicadas alrededor de los Valles del Orbe (Venus)."],"img":"objects-venus-theme-crparachnoidpowercoremicroid","planets":[],"sources":[{"k":"enemy","who":"Narmer Mite","eff":1.0},{"k":"enemy","who":"Mite Raknoid","eff":1.0},{"k":"enemy","who":"Orb Vallis - Spaceport Enemies","eff":1.9998}],"usedIn":["Powersuits/Pacifist/Pacifist","Powersuits/Garuda/Garuda"],"refs":{"Powersuits/Pacifist/Pacifist":{"tab":"arsenal","slug":"baruuk","slugEs":"baruuk","name":["Baruuk","Baruuk"],"img":"storeicons-warframes-pacifist"},"Powersuits/Garuda/Garuda":{"tab":"arsenal","slug":"garuda","slugEs":"garuda","name":["Garuda","Garuda"],"img":"storeicons-warframes-garuda"}}},"yogwun-stomach":{"slug":"yogwun-stomach","slugEs":"estomago-de-yogwun","name":["Yogwun Stomach","Estómago de Yogwun"],"desc":["Once cleaned and tanned this organ can be turned into a durable leather.\n\nSource: Cut from Yogwun fish via Fisher Hai-Luk in Cetus (Earth). Catch Yogwun in Plains of Eidolon ponds during the Day. Also drops from Thumpers in the Plains of Eidolon.","Una vez limpiado y curtido este órgano puede ser convertido en un durable cuero.\n\nFuente: Obtenido del pez Yogwun con la Pescadora Hai-Luk en Cetus (Tierra). Captura al Yogwun en los estanques de las Llanuras de Eidolon durante el día. También se obtiene de los pistones en las Llanuras de Eidolon."],"img":"storeicons-fishing-eidolon-fishresourceribcage","planets":[],"sources":[{"k":"enemy","who":"Tusk Thumper Doma","eff":33.36},{"k":"enemy","who":"Tusk Thumper Bull","eff":25.02},{"k":"enemy","who":"Tusk Thumper","