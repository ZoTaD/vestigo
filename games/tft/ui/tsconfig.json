{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client"],
    "paths": {
      "@data/*": ["../data/*"],
      "@analysis/*": ["../analysis/src/*"],
      "@deadlock/*": ["../../deadlock/data/*"]
    }
  },
  "include": ["src", "vite.config.ts", "dev-api.ts"]
}
