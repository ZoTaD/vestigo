# Copiá este archivo a .env.local para apuntar la UI a la Edge Function.
# Sin estas variables la UI usa el middleware de desarrollo (dev-api.ts), que
# habla con la Riot API usando la key de games/tft/pipeline/.env.

# La función desplegada. Sin barra final.


# Clave publicable del proyecto. Es pública por diseño: no da acceso a nada por
# sí sola, porque todas las tablas tienen RLS sin políticas anon. NO es la
# service role key, que nunca debe salir del servidor.


# ID de medición de Google Analytics. Va solo en producción (se configura en
# Netlify), nunca acá: sin esta variable no se carga ningún script de analytics
# y el aviso de cookies no aparece, que es lo que queremos en desarrollo.
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

