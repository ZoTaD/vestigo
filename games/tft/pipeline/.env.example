# Copy this file to .env and paste your key. .env is gitignored.
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
RIOT_REGION=na1
RIOT_ROUTING=americas

# Solo para `npm run migrate:pg`. La service role key bypassea RLS: vive solo
# server-side, nunca en el navegador y nunca en git. Está en el dashboard de
# Supabase, en Project Settings > API.



# Solo para `npm run summarize` (ver r2Archive.ts y deleteOldRaw en
# summarize-run.ts): archivan cada partida cruda en Cloudflare R2 antes de
# borrarla de Postgres. El endpoint y el bucket NO van acá — son constantes en
# r2Archive.ts, no son secretos. Se generan en el dashboard de Cloudflare, en
# R2 > Manage API tokens.
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# La base es Cloudflare D1. El token se crea en el dashboard con permisos de
# cuenta D1 Read + D1 Write, y en CI vive en los secrets del repo.
CLOUDFLARE_API_TOKEN=cfut_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
