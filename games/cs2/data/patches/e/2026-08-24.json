{"date":"2026-08-24","title":"Counter-Strike 2 Update","url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1841579228676851","kind":"patch","sections":[{"title":"MAP SCRIPTING","lines":[{"text":"Added custom_hud_layout entity:","dir":"new"},{"text":"custom_hud_layouts are the entry point for scripted maps to provide custom UI.","dir":"mid","sub":true},{"text":"Panel, Label, Image, and Button panel types are supported.","dir":"mid","sub":true},{"text":"Styling with css is supported.","dir":"mid","sub":true},{"text":"Events and client side scripting are not supported.","dir":"mid","sub":true},{"text":"Maintains state during tools mode reloads.","dir":"mid","sub":true},{"text":"Added cs_player_camera entity:","dir":"new"},{"text":"Gives control of a player's view without moving their pawn.","dir":"mid","sub":true},{"text":"Can be configured to let the player look around from the scripted position.","dir":"mid","sub":true},{"text":"Added Instance.Delay","dir":"new"},{"text":"Added Instance.OnBombPlantStart","dir":"new"},{"text":"Added Instance.OnBombPlantAbort","dir":"new"},{"text":"Added Instance.OnBombDefuseStart","dir":"new"},{"text":"Added Instance.OnBombDefuseAbort","dir":"new"},{"text":"Added Instance.OnCustomHudClicked","dir":"new"},{"text":"Added Instance.IsDedicatedServer","dir":"new"},{"text":"Added Entity.Move","dir":"new"},{"text":"Added Entity.GetMoveType","dir":"new"},{"text":"Added Entity.SetMoveType","dir":"new"},{"text":"Added CSPlayerPawn.GetC4","dir":"new"},{"text":"Added CSPlayerPawn.GetDefuseTarget","dir":"new"},{"text":"Added CSPlayerPawn.IsBuyMenuOpen","dir":"new"},{"text":"Added CSPlayerPawn.GetCamera","dir":"new"},{"text":"Added C4.GetPlantStartTime","dir":"new"},{"text":"Added C4.GetPlantFinishTime","dir":"new"},{"text":"Added C4.AbortPlant","dir":"new"},{"text":"Added CustomHudLayout.SetHasClass","dir":"new"},{"text":"Added CustomHudLayout.SetHasClassForPlayer","dir":"new"},{"text":"Added CustomHudLayout.SetDialogVariableString","dir":"new"},{"text":"Added CustomHudLayout.SetDialogVariableStringForPlayer","dir":"new"},{"text":"Added CustomHudLayout.SetInputCaptureEnabled","dir":"new"},{"text":"Added CustomHudLayout.IsInputCaptureEnabled","dir":"new"},{"text":"Added CSPlayerCamera.IsEnabled","dir":"new"},{"text":"Added CSPlayerCamera.SetEnabled","dir":"new"},{"text":"Added CSPlayerCamera.SetIsControllingAngles","dir":"new"},{"text":"Added enum CSMoveType","dir":"new"},{"text":"Corrected types for some events where parameters were maybe undefined.","dir":"mid"},{"text":"Errors encountered during initial script run are now logged to the console.","dir":"mid"},{"text":"Unhandled promise rejections are now logged to the console.","dir":"mid"},{"text":"Added the column number to errors caught during the CompileModule step of script loading.","dir":"new"},{"text":"Deprecated planter from Instance.OnBombPlant event","dir":"mid"},{"text":"Deprecated defuser from Instance.OnBombDefuse event","dir":"mid"}]}],"slug":"2026-08-24"}