nemigo, lo que inflige "},{"t":"daño espiritual","attr":"SpiritDamage","icon":"attr_SpiritDamage"},{"t":" y "},{"t":"marca","hi":true},{"t":" al objetivo. Disparar a un enemigo marcado con un disparo potenciado consume la marca para infligir "},{"t":"daño espiritual adicional","attr":"BonusSpiritDamage","icon":"attr_BonusSpiritDamage"},{"t":" y aplicar una "},{"t":"ralentización","attr":"Slow","icon":"attr_Slow"},{"t":" decreciente. "},{"t":"Mantén pulsado y arrastra para elegir el ángulo.","dim":true}],"groups":[{"stats":[{"label":"Daño","value":"27","unit":"","icon":"https://assets-bucket.deadlock-api.com/assets-api-res/icons/icons/properties/damage_magic_color.svg","spirit":0.74},{"label":"Daño al objetivo marcado","value":"45","unit":"","icon":"https://assets-bucket.deadlock-api.com/assets-api-res/icons/icons/properties/damage_magic_color.svg","spirit":1.1},{"label":"Ralentización decreciente","value":"40","unit":"%","icon":"https://assets-bucket.deadlock-api.com/assets-api-res/icons/icons/properties/condition_slow.svg"}]}],"basics":[{"label":"Duración de la marca","value":"10.0","unit":"s","icon":"https://assets-bucket.deadlock-api.com/assets-api-res/icons/icons/properties/duration.svg"},{"label":"Duración de la ralentización","value":"1.5","unit":"s","icon":"https://assets-bucket.deadlock-api.com/assets-api-res/icons/icons/properties/duration.svg"},{"label":"Retraso de la explosión","value":"6.0","unit":"s","icon":"https://assets-bucket.deadlock-api.com/assets-api-res/icons/icons/properties/duration.svg"}]}],"cooldown":{"label":"Tiempo de recarga","value":"25","unit":"s","icon":"https://assets-bucket.deadlock-api.com/assets-api-res/icons/icons/properties/cooldown.svg"},"upgrades":[[{"t":"-12 s de tiempo de recarga"}],[{"t":"+30 de daño y +45 de daño al objetivo marcado"}],[{"t":"+2 misiles, mayor alcance y escalado espiritual mejorado"}]]},{"id":1904698842,"slot":2,"ultimate":false,"name":"Quimera Mk1","img":"https://assets-bucket.deadlock-api.com/assets-api-r