node_modules/
dist/
# Every env file is per-machine and stays out of git. Listing the variants one
# by one kept missing new ones (.env.local, then .env.local.off), so the rule is
# now "everything except the committed templates".
.env*
!.env.example
*.log

# ow-electron dev credentials
desktop/.env

# Incremental build state from `tsc -b`, regenerated on every build.
*.tsbuildinfo

# Local editor/tooling config, not part of the project.
.claude/
.codex/

# Cache local de la ventana del snapshot de Deadlock (REPORT_CACHE=1). Son
# cientos de MB y se regenera solo; existe para no volver a bajar cinco minutos
# de datos cada vez que se afina la fórmula de la nota.
*.duckdb

# Maquetas del companion de brainstorming. Son HTML de un solo uso y con los
# retratos incrustados pesan más de un mega cada una; lo que hay que conservar
# de una sesión de diseño es el documento en docs/design, no el andamio.
.superpowers/
# PoE2: listas generadas por games/poe2/tools (pesan cientos de MB)
games/poe2/tools/*.json
.cache/
games/poe2/.cache/
# PoE2: HTML de los hilos del foro que baja games/poe2/pipeline/patches.mjs
games/poe2/data/patches/.cache/
__pycache__/

# Valheim: el entorno de Python del extractor y su caché, locales.
games/valheim/.venv/
games/valheim/.cache/
